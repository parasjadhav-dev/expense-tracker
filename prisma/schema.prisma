// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  categories Category[]
  expenses   Expense[]
  budgets    Budget[]
  recurring  RecurringExpense[]
  passwordResets PasswordResetToken[]
}

// A one-time "forgot password" link. Only a SHA-256 hash of the token is stored,
// so a database leak does not hand out working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  budgets   Budget[]
  recurring RecurringExpense[]

  @@unique([userId, name])
}

model Expense {
  id         String   @id @default(cuid())
  amount     Int // in paise: ₹199.50 is stored as 19950
  date       DateTime
  note       String?
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Set on expenses created from a recurring item: which item, and for which
  // month ("2026-11"). The pair is unique, so a month is never created twice.
  recurringId    String?
  recurringMonth String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurring RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, recurringMonth])
  @@index([userId, date])
}

// An expense that repeats on one day of every month (rent, a subscription).
// Expenses are created for it as each due date arrives; see lib/recurring.ts.
model RecurringExpense {
  id                 String   @id @default(cuid())
  amount             Int // in paise
  note               String?
  dayOfMonth         Int // 1-31; a shorter month uses its last day
  startMonth         String // "2026-11": the first month it runs
  lastGeneratedMonth String // newest month already handled; the month before startMonth when new
  active             Boolean  @default(true)
  userId             String
  categoryId         String
  createdAt          DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@index([userId])
}

model Budget {
  id         String  @id @default(cuid())
  month      String // "2026-11"
  amount     Int // in paise
  userId     String
  categoryId String? // null means the overall monthly budget

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as distinct, so this does not stop two overall budgets
  // (categoryId NULL) for the same user and month. A partial unique index,
  // "Budget_overall_userId_month_key", does that. Prisma cannot express it here,
  // so it lives only in the migration 20261109120000_overall_budget_unique. Apply
  // migrations with `prisma migrate deploy`; `db push` would not create it.
  @@unique([userId, categoryId, month])
}

# Copy this file to .env and fill in your own values. Never commit .env.

# Neon PostgreSQL connection string.
# sslmode=verify-full avoids the pg driver's SSL deprecation warning.
DATABASE_URL="your_neon_database_url_here"

# Auth.js secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-value"

# Public URL of the app. Local: http://localhost:3000. On Vercel, set it to the live URL.
AUTH_URL="http://localhost:3000"

# Optional. Time zone that decides what "today" and "this month" mean.
# An IANA name, for example Asia/Kolkata (the default) or America/New_York.
# APP_TIME_ZONE="Asia/Kolkata"

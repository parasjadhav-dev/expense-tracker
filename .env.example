# Copy this file to .env and fill in your own values. Never commit .env.

# Neon PostgreSQL connection string.
# sslmode=verify-full avoids the pg driver's SSL deprecation warning.
DATABASE_URL="your_neon_database_url_here"

# Auth.js secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-value"

# Public URL of the app. Local: http://localhost:3000. On Vercel, set it to the live URL.
AUTH_URL="http://localhost:3000"

# Forgot-password emails. Pick ONE of these (SMTP wins if both are set).
# With neither, local development prints the reset link in the server log instead;
# production needs one of them.
#
# Option 1: Gmail SMTP. Free, any recipient, no domain needed. Turn on 2-step
# verification, then create an app password at https://myaccount.google.com/apppasswords
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="abcd efgh ijkl mnop"
# SMTP_HOST="smtp.gmail.com"   # optional
# SMTP_PORT="465"              # optional
# EMAIL_FROM="Expense Tracker <you@gmail.com>"   # optional; Gmail only sends as you
#
# Option 2: Resend (https://resend.com). Needs a verified domain to email other
# people; without one it only delivers to your own Resend account email.
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="Expense Tracker <noreply@yourdomain.com>"

# Optional. Time zone that decides what "today" and "this month" mean.
# An IANA name, for example Asia/Kolkata (the default) or America/New_York.
# APP_TIME_ZONE="Asia/Kolkata"
